menuconfig CONFIG_USB_VENDOR
	bool "USB vendor setting"
	default n
	---help---
		USB vendor setting for HICHIP SOC

	if CONFIG_USB_VENDOR
		config CONFIG_USB_PHY_SETTING
		bool "enable USB PHY setting"
		default n

		config CONFIG_USB_GADGET_VBUS_DETECT
		bool "detect usb#0 gadget connect/disconnect by VBUS"
		default n
		---help---
			The hardware development board needs to be connected to 
			the VBUS pin, then you can determine whether there is a 
			USB host connection by detecting the VBUS status value.

		menuconfig CONFIG_USB_GADGET_VENDOR
			bool "USB gadget vendor support"
			default n

		if CONFIG_USB_GADGET_VENDOR
			config CONFIG_USB_ZERO
				bool "usb gadget demo: zero"
				default n
		endif

		if CONFIG_USB_GADGET_VENDOR
			config CONFIG_USB_GADGET_HID_VENDOR
				bool "usb gadget demo: hid mouse/keyboard report parameters"
				default n
		endif

		if CONFIG_USB_GADGET_VENDOR
			config BR2_USBGADGETDRIVER_MSC_BUFLEN
				int "usb gadget mass-storage buffer size (uint: KB)"
				depends on BR2_PACKAGE_PREBUILTS_USBGADGETDRIVER_MSC
				range 4 512
				default 16
		endif

		if CONFIG_USB_GADGET_VENDOR
			config BR2_USBGADGETDRIVER_UVC_MAXPACKET
				int "usb gadget uvc : max packet size (uint: Bytes, rang: 1 ~ 1024)"
				depends on BR2_PACKAGE_PREBUILTS_USBGADGETDRIVER_UVC
				range 1 1024
				default 1024
		endif

		
	endif
 
